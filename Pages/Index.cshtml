@page
@model IndexModel
@* @{
    Layout = null;
    } *@

@* @{
    ViewData["Title"] = "Home page";
    } *@

<div class="form-container">

    <h1>Анкета студента</h1>

    <p class="description">
        Введите свои данные
    </p>

    <form method="post">

        <div class="form-group">
            <label>Имя-фамилия:</label>
            <input type="text" name="Name" placeholder="Введите имя" required>
        </div>

        <div class="form-group">
            <label>Номер телефона:</label>
            <input type="tel" name="Phone" placeholder="+7" required>
        </div>

        <div class="form-group">
            <label>Email:</label>
            <input type="email" name="Email" placeholder="email@example.com" required>
        </div>

        <div class="form-group">
            <label>Специальность:</label>

            <div class="speciality">

                <input type="radio" name="Speciality" value="Программирование" id="dev">
                <label for="dev">Программирование</label>

                <br>

                <input type="radio" name="Speciality" value="Дизайн" id="design">
                <label for="design">Дизайн</label>

                <br>

                <input type="radio" name="Speciality" value="Маркетинг" id="marketing">
                <label for="marketing">Маркетинг</label>

            </div>
        </div>
        <div class="form-group">
            <label for="courses">Курс:</label>
            <select name="Course" id="courses">
                <option value="1 курс">1 курс</option>
                <option value="2 курс">2 курс</option>
                <option value="3 курс">3 курс</option>
                <option value="4 курс">4 курс</option>
            </select>
        </div>
        <div class="form-group">
            <label for="">Дата рождения:</label>
            <input type="date" name="BirthDate" required>
        </div>
        <div class="form-group">
            <label for="">Технологии:</label>
            <div class="speciality">
                <input type="checkbox" name="Technologies" value="HTML/CSS" id="html">
                <label for="html">HTML/CSS</label>
                <br>
                <input type="checkbox" name="Technologies" value="JavaScript" id="js">
                <label for="js">JavaScript</label>
                <br>
                <input type="checkbox" name="Technologies" value="C#" id="csharp">
                <label for="csharp">C#</label>
                <br>
                <input type="checkbox" name="Technologies" value="Python" id="python">
                <label for="python">Python</label>
            </div>
        </div>


        <div class="form-group">
            <label>Город:</label>
            <select name="City" required>
                <option value="">Выберите город</option>
                <option value="Москва">Москва</option>
                <option value="Санкт-Петербург">Санкт-Петербург</option>
                <option value="Новосибирск">Новосибирск</option>
                <option value="Новосибирск">Сочи</option>
            </select>
        </div>


        <div class="form-group">
            <label>Основной язык программирования:</label>
            <select name="MainLanguage" required>
                <option value="C#">C#</option>
                <option value="Java">Java</option>
                <option value="Python">Python</option>
                <option value="JavaScript">JavaScript</option>
            </select>
        </div>


        <div class="form-group">
            <label>Формат обучения:</label>
            <div class="speciality">
                <input type="radio" name="EducationFormat" value="Очно" id="fmt1" required>
                <label for="fmt1">Очно</label>
                <br>
                <input type="radio" name="EducationFormat" value="Заочно" id="fmt2">
                <label for="fmt2">Заочно</label>
                <br>
                <input type="radio" name="EducationFormat" value="Дистанционное" id="fmt3">
                <label for="fmt3">Дистанционное</label>
            </div>
        </div>


        <div class="form-group">
            <label>Информация о себе:</label>
            <textarea name="AboutSelf" placeholder="Расскажите немного о себе..."></textarea>
        </div>

        <button class="form-button" type="submit">
            Отправить
        </button>

    </form>


    <div id="result" class="student-card">
        <div class ="student-card-header">
            <h2>Анкета отправлена</h2>
            <p>Данные студента</p>
        </div>
        <div class="student-info">
            <div class="info-item"></div>
                <span>Имя</span>
            <strong id="result-name"></strong>
        </div>
            <div class="info-item"></div>
                <span>Телефон</span>
            <strong id="result-phone"></strong>
        </div>
            <div class="info-item"></div>
                <span>Почта</span>
            <strong id="result-email"></strong>
        </div>
            <div class="info-item"></div>
                 <span>День рождения</span>
            <strong id="result-birthay"></strong>
        </div>
            <div class="info-item"></div>
                <span>Город</span>
            <strong id="result-city"></strong>
        </div>
            <div class="info-item"></div>
                <span>Специальность</span>
            <strong id="result-speciality"></strong>
        </div>
            <div class="info-item"></div>
                <span>Курс</span>
            <strong id="result-course"></strong>
        </div>
            <div class="info-item"></div>
                <span>Основной язык</span>
            <strong id="result-mainlanguage"></strong>
        </div>
            <div class="info-item"></div>
                <span>Формат обучения</span>
            <strong id="result-format"></strong>
        </div>
            <div class="info-item"></div>
                <span>Технологии</span>
            <strong id="result-tehnology"></strong>
        </div>
            <div class="info-item"></div>
                <span>О себе</span>
            <strong id="result-AboutMe"></strong>
        </div>

    </div>
    @if (Model.Message != null)
    {
        <div class="result">
            <h3>Данные анкеты:</h3>

            <p style="white-space: pre-line;">
                @Model.Message
            </p>
        </div>
    }

</div>

<script>
    const form = document.querySelector("form");

    form.addEventListener("submit", async function (event) {
        event.preventDefault();

        const button = form.querySelector("button");
        const formData = new FormData(form);
        button.disabled = true;
        button.textContent = "Отправка...";
        console.log(form);
        console.log(button);
        console.log(formData);



        const response = await fetch("", {
            method: "POST",
            body: formData
        });

        const data = await response.json()
        await new Promise(resolve => setTimeout(resolve, 1500));

        document.querySelector("#result-name").textContent = data.Name
        document.querySelector("#result-phone").textContent = data.Phone
        document.querySelector("#result-email").textContent = data.Email
        document.querySelector("#result-birthay").textContent = data.BirthDate
        document.querySelector("#result-city").textContent = data.City
        document.querySelector("#result-speciality").textContent = data.Speciality
        document.querySelector("#result-course").textContent = data.Course
        document.querySelector("#result-mainlanguage").textContent = data.MainLanguage
        document.querySelector("#result-format").textContent = data.EducationFormat
        document.querySelector("#result-tehnology").textContent = data.Technologies
        document.querySelector("#result-AboutMe").textContent = data.AboutSelf

        console.log(data);
        document.querySelector("#result").style.display = "block";
        button.disabled = false;
        button.textContent = "анкета отправлена 🤞";
    });
</script>
